{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "steam-logros",
  "main": "server/adapters/worker.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // El frontend compilado se sirve como estáticos de Cloudflare, sin pasar por
  // el Worker. single-page-application devuelve index.html en las rutas que no
  // son un archivo, para que funcionen /u/<steamid>/<appid> y /datos.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // Sin KV declarado a propósito: así el despliegue no depende de ningún recurso
  // previo y el botón de "Deploy to Cloudflare" funciona de una. La caché de las
  // respuestas de Steam vive en memoria del isolate.
  //
  // Para pasarla a KV, que sobrevive entre peticiones y reduce las llamadas a
  // Steam, no hay que tocar código: el servidor detecta el binding en tiempo de
  // ejecución (server/cache/index.ts). Dos formas:
  //
  //   a) Desde el panel: Workers & Pages -> steam-logros -> Settings -> Bindings
  //      -> Add -> KV namespace, con el nombre de binding CACHE.
  //   b) Desde la terminal: `npx wrangler kv namespace create CACHE` y pegar acá
  //      el id que devuelve, dentro de un bloque "kv_namespaces".

  "vars": {
    "DEFAULT_STEAM_LANGUAGE": "spanish",
    "DEMO_STEAMID": "76561197960435530",
    "STEAM_MOCK": "0"
  }
}
