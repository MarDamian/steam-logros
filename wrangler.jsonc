{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Nombre del Worker al que se despliega. `wrangler deploy` lo lee de acá, así
  // que tiene que coincidir con el Worker que exista en la cuenta — no con el
  // nombre del repo, que acá es "steam-logros". Si clonás este repo, cambialo
  // por el tuyo.
  "name": "steam-logros-cf",
  "main": "server/adapters/worker.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // El frontend compilado se sirve como estáticos de Cloudflare, sin pasar por
  // el Worker. single-page-application devuelve index.html en las rutas que no
  // son un archivo, para que funcionen /u/<steamid>/<appid> y /datos.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Sin esto, los estáticos se sirven ANTES que el Worker y, como
    // not_found_handling es single-page-application, cualquier *navegación* del
    // navegador a una ruta que no sea un archivo recibe index.html sin que el
    // Worker llegue a ejecutarse. Las llamadas desde JavaScript sí llegaban,
    // porque no son navegaciones: por eso la API funcionaba y el botón de
    // "Entrar con Steam" recargaba la página. El login de Steam son dos
    // navegaciones (ir a /api/auth/steam/start y volver a /api/auth/steam/return).
    "run_worker_first": ["/api/*"]
  },

  // Caché de las respuestas de Steam. Va declarada acá y no solo en el panel:
  // `wrangler deploy` reemplaza los bindings con los de este archivo, así que un
  // binding agregado a mano desde el panel lo borraría el próximo despliegue.
  //
  // Si clonás este repo, creá tu propio namespace con
  //   npx wrangler kv namespace create CACHE
  // y reemplazá el id. O borrá este bloque entero: la app funciona igual, con la
  // caché en memoria del isolate (server/cache/index.ts lo detecta solo).
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "14d5c0c0ce074ad9a66a5aed3b7afdc2"
    }
  ],

  "vars": {
    "DEFAULT_STEAM_LANGUAGE": "spanish",
    "DEMO_STEAMID": "76561197960435530",
    "STEAM_MOCK": "0"
  }
}
