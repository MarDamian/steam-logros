{
  "name": "steam-logros-cf",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/adapters/node.ts",
    "build": "vite build && npm run build:server",
    "preview": "vite preview",
    "start": "node dist/server/node.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "guides:build": "tsx tools/build-wukong-pack.ts",
    "guides:schema": "tsx tools/guides-schema.ts",
    "guides:check": "tsx tools/guides-check.ts",
    "deploy": "npm run build && wrangler deploy",
    "build:client": "vite build",
    "build:server": "esbuild server/adapters/node.ts --bundle --platform=node --target=node22 --format=esm --packages=bundle --outfile=dist/server/node.mjs --log-level=warning",
    "start:ts": "tsx server/adapters/node.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^2.1.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
