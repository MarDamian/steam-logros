# Clave de la Web API de Steam. Se saca en https://steamcommunity.com/dev/apikey
# SOLO servidor: nunca se envia al navegador.
STEAM_API_KEY=

# Secreto para firmar la cookie de sesion (HMAC-SHA256).
# Hace falta para el boton "Entrar con Steam". Generalo con: openssl rand -hex 32
SESSION_SECRET=

# URL publica de la app, sin barra final. De aqui salen el return_to y el realm
# que se le mandan a Steam, y contra esto se valida la respuesta: si no coincide
# con el dominio real, el login falla a proposito.
# En local: http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173

# Perfil publico de ejemplo para el "modo demo" (SteamID64 de 17 digitos).
# Este tiene el perfil en publico, pero conviene comprobar con tu clave que
# tambien tenga "Detalles del juego" en publico antes de confiar en el.
DEMO_STEAMID=76561197960435530

# Pon 1 para trabajar sin clave: el servidor responde con fixtures locales.
STEAM_MOCK=0

# Idioma por defecto que se pide a Steam (spanish | english)
DEFAULT_STEAM_LANGUAGE=spanish
